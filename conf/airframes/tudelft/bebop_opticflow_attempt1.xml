<!DOCTYPE airframe SYSTEM "../airframe.dtd">

<airframe name="bebop_avoider">
  <description>Bebop Obstacle Avoider - Custom Optic Flow Attempt 1</description>

  <firmware name="rotorcraft">
    <target name="ap" board="bebop">
      <define name="VIDEO_CAPTURE_PATH" value="/data/ftp/internal_000/images"/>
      <define name="LOGGER_FILE_PATH" value="/data/ftp/internal_000/log"/>
      <module name="ahrs" type="int_cmpl_quat">
        <configure name="USE_MAGNETOMETER" value="FALSE"/>
        <define name="AHRS_USE_GPS_HEADING" value="TRUE"/>
      </module>
    </target>

    <target name="nps" board="pc">
      <module name="fdm" type="gazebo"/>
      <module name="gps" type="nps"/>
      <module name="ahrs" type="float_mlkf">
        <configure name="USE_MAGNETOMETER" value="FALSE"/>
        <define name="AHRS_USE_GPS_HEADING" value="TRUE"/>
      </module>
    </target>
    
    <module name="telemetry" type="transparent_udp"/>
    <module name="radio_control" type="datalink"/>
    <module name="motor_mixing"/>
    <module name="actuators" type="bebop"/>
    <module name="imu" type="bebop"/>
    <module name="gps" type="datalink"/>
    <module name="stabilization" type="indi_simple"/>
    <module name="stabilization" type="rate_indi"/>
    <module name="ins" type="extended"/>

    <module name="bebop_cam"/>
    <module name="video_thread"/>
    <module name="video_rtp_stream">
      <define name="VIEWVIDEO_CAMERA" value="front_camera"/>
    </module>

    <module name="opticflow_attempt1">
      <define name="OPTICFLOW_CAMERA" value="front_camera"/>
      <define name="OBSTACLE_TTC_THRESHOLD" value="1.5"/>
    </module>
  </firmware>
    <section name="SIMULATOR" prefix="NPS_">
        <define name="ACTUATOR_NAMES"  value="nw_motor, ne_motor, se_motor, sw_motor" type="string[]"/>
        <define name="JSBSIM_MODEL" value="simple_quad" type="string"/>
        <define name="COMMANDS_NB" value="4"/>
        <define name="ACTUATOR_THRUSTS" value="1.55, 1.55, 1.55, 1.55" type="float[]"/>
        <define name="ACTUATOR_TORQUES" value="0.01, 0.01, 0.01, 0.01" type="float[]"/>
    </section>

  <section name="GUIDANCE_V" prefix="GUIDANCE_V_">
    <define name="HOVER_KP"    value="283"/>
    <define name="HOVER_KD"    value="82"/>
    <define name="HOVER_KI"    value="13"/>
    <define name="NOMINAL_HOVER_THROTTLE" value="0.6"/>
    <define name="ADAPTIVE_THROTTLE_ENABLED" value="TRUE"/>
  </section>

  <section name="STABILIZATION_ATTITUDE_INDI" prefix="STABILIZATION_INDI_">
    <define name="G1_P" value="0.0397"/><define name="G1_Q" value="0.0299"/><define name="G1_R" value="0.0014"/><define name="G2_R" value="0.1219"/>
    <define name="REF_ERR_P" value="600.0"/><define name="REF_ERR_Q" value="600.0"/><define name="REF_ERR_R" value="600.0"/>
    <define name="REF_RATE_P" value="14.0"/><define name="REF_RATE_Q" value="14.0"/><define name="REF_RATE_R" value="14.0"/>
    <define name="FILT_CUTOFF" value="8.0"/>
    <define name="ADAPTIVE_MU" value="0.0001"/>
    <define name="ACT_FREQ_P" value="53.9"/><define name="ACT_FREQ_Q" value="53.9"/><define name="ACT_FREQ_R" value="53.9"/>
  </section>

  <commands>
    <axis name="PITCH" failsafe_value="0"/>
    <axis name="ROLL" failsafe_value="0"/>
    <axis name="YAW" failsafe_value="0"/>
    <axis name="THRUST" failsafe_value="0"/>
  </commands>

  <servos driver="Default">
    <servo name="TOP_LEFT"     no="0" min="3000" neutral="3000" max="9800" />
    <servo name="TOP_RIGHT"    no="1" min="3000" neutral="3000" max="9800" />
    <servo name="BOTTOM_RIGHT" no="2" min="3000" neutral="3000" max="9800" />
    <servo name="BOTTOM_LEFT"  no="3" min="3000" neutral="3000" max="9800" />
  </servos>

  <section name="MIXING" prefix="MOTOR_MIXING_">
    <define name="TRIM_ROLL" value="0"/>
    <define name="TRIM_PITCH" value="0"/>
    <define name="TRIM_YAW" value="0"/>
    <define name="NB_MOTOR" value="4"/>
    <define name="TYPE" value="QUAD_X"/>
  </section>

  <command_laws>
    <call fun="motor_mixing_run(autopilot_get_motors_on(),FALSE,values)"/>
    <set servo="TOP_LEFT"     value="motor_mixing.commands[MOTOR_FRONT_LEFT]"/>
    <set servo="TOP_RIGHT"    value="motor_mixing.commands[MOTOR_FRONT_RIGHT]"/>
    <set servo="BOTTOM_RIGHT" value="motor_mixing.commands[MOTOR_BACK_RIGHT]"/>
    <set servo="BOTTOM_LEFT"  value="motor_mixing.commands[MOTOR_BACK_LEFT]"/>
  </command_laws>

  <section name="STABILIZATION_ATTITUDE" prefix="STABILIZATION_ATTITUDE_">
    <define name="SP_MAX_PHI" value="45" unit="deg"/>
    <define name="SP_MAX_THETA" value="45" unit="deg"/>
    <define name="SP_MAX_R" value="120" unit="deg/s"/>
    <define name="DEADBAND_A" value="0"/>
    <define name="DEADBAND_E" value="0"/>
    <define name="DEADBAND_R" value="50"/>
  </section>

  <section name="GUIDANCE_H" prefix="GUIDANCE_H_">
    <define name="MAX_BANK" value="20" unit="deg"/>
    <define name="REF_MAX_SPEED" value="0.5" unit="m/s"/>
    <define name="PGAIN" value="120"/><define name="DGAIN" value="230"/><define name="IGAIN" value="40"/>
  </section>

  <section name="AUTOPILOT">
    <define name="MODE_STARTUP" value="AP_MODE_NAV"/>
    <define name="MODE_MANUAL" value="AP_MODE_ATTITUDE_DIRECT"/>
    <define name="MODE_AUTO1" value="AP_MODE_ATTITUDE_Z_HOLD"/>
    <define name="MODE_AUTO2" value="AP_MODE_NAV"/>
  </section>
</airframe>