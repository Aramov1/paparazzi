<!DOCTYPE module SYSTEM "module.dtd">
<module name="cv_detect_contour_edited" dir="computer_vision">
  <doc>
    <description>Gate detection using blue TUDelft patch contours.</description>
    <define name="DETECT_CONTOUR_EDITED_CAMERA" value="front_camera" description="Camera to use"/>
    <define name="DETECT_CONTOUR_EDITED_FPS" value="0" description="Max FPS, 0 = camera rate"/>
  </doc>
  <header>
    <file name="detect_contour_edited.h"/>
  </header>
  <init fun="detect_contour_edited_init()"/>
  <makefile target="nps">
  <file name="detect_contour_edited.c"/>
  <file name="opencv_contour_edited.cpp"/>
  <file name="opencv_image_functions.cpp"/>
  <flag name="CXXFLAGS" value="I/usr/include/opencv4"/>
  <flag name="LDFLAGS" value="lopencv_imgproc"/>
  <flag name="LDFLAGS" value="lopencv_core"/>
  <flag name="LDFLAGS" value="lstdc++"/>
</makefile>
  <makefile target="ap">
    <file name="detect_contour_edited.c"/>
    <file name="opencv_contour_edited.cpp"/>
    <file name="opencv_image_functions.cpp"/>
    <flag name="CXXFLAGS" value="I$(PAPARAZZI_SRC)/sw/ext/opencv_bebop/install/include"/>
    <flag name="LDFLAGS" value="L$(PAPARAZZI_SRC)/sw/ext/opencv_bebop/install/lib"/>
    <flag name="LDFLAGS" value="lopencv_imgproc"/>
    <flag name="LDFLAGS" value="lopencv_core"/>
    <flag name="LDFLAGS" value="lstdc++"/>
    <flag name="LDFLAGS" value="ldl"/>
    <flag name="LDFLAGS" value="lm"/>
    <flag name="LDFLAGS" value="lpthread"/>
  </makefile>
</module>