<!DOCTYPE module SYSTEM "module.dtd">
<module name="gate_navigator" dir="gate_navigator">
  <doc>
    <description>
    Gate detection and navigation FSM for AE4317 Autonomous Flight of MAV Course.
    Requires cv_detect_contour_edited for gate detection.
    Passively detects gates; transitions waypoint_navigation into GATE_TRACKING on detection.
    </description>
    <define name="GATE_DETECTION_ENABLED" value="1" description="Enable gate detection at startup (0=off, 1=on)"/>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings name="Gate_Navigator">
        <dl_setting var="gate_detection_enabled" min="0" step="1" max="1"
                    shortname="gate_detect" module="gate_navigator/gate_nav" values="Off|On"/>
        <dl_setting var="gate_show_overlay" min="0" step="1" max="1"
                    shortname="gate_overlay" module="gate_navigator/gate_nav" values="Off|On"/>
        <dl_setting var="gate_ttc_safe_threshold" min="0.5" step="0.5" max="30.0"
                    shortname="gate_ttc" module="gate_navigator/gate_nav"/>
      </dl_settings>
    </dl_settings>
  </settings>
  <header>
    <file name="gate_nav.h"/>
  </header>
  <init fun="gate_navigator_init()"/>
  <periodic fun="gate_navigator_periodic()" freq="60"/>
  <makefile target="ap|nps">
    <file name="gate_nav.c"/>
  </makefile>
</module>
