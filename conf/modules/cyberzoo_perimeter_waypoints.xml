<!DOCTYPE module SYSTEM "module.dtd">

<module name="cyberzoo_perimeter_waypoints" dir="cyberzoo_navigation">
  <doc>
    <description>
      Builds a moving global trajectory waypoint along the Cyberzoo inner perimeter corners
      (_OZ1.._OZ4). Other modules can track WP_TRAJECTORY and still apply local obstacle
      avoidance around that global target.
    </description>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings name="CyberzooPerimeter">
        <dl_setting var="cz_perimeter_lookahead" min="0.2" step="0.1" max="3.0"/>
        <dl_setting var="cz_perimeter_corner_radius" min="0.2" step="0.1" max="2.0"/>
      </dl_settings>
    </dl_settings>
  </settings>
  <header>
    <file name="cyberzoo_perimeter_waypoints.h"/>
  </header>
  <init fun="cyberzoo_perimeter_nav_init()"/>
  <periodic fun="cyberzoo_perimeter_nav_periodic()" freq="8"/>
  <makefile target="ap|nps">
    <file name="cyberzoo_perimeter_waypoints.c"/>
  </makefile>
</module>
