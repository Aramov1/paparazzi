<!DOCTYPE module SYSTEM "module.dtd">
<module name="obstacle_avoider" dir="mav_course_exercise/obstacle_avoider">
  <doc>
    <description>TTC-based obstacle avoider using opticflow divergence</description>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings name="Obstacle_Avoider_Settings">
        <dl_setting var="OA_WARNING_TTC"    min="0.5" step="0.1" max="5.0"  shortname="warn_ttc"   module="mav_course_exercise/obstacle_avoider/obstacle_avoider"/>
        <dl_setting var="OA_SAFETY_TTC"     min="0.1" step="0.1" max="2.0"  shortname="safe_ttc"   module="mav_course_exercise/obstacle_avoider/obstacle_avoider"/>
        <dl_setting var="OA_MIN_FPS"        min="1.0" step="1.0" max="30.0" shortname="min_fps"    module="mav_course_exercise/obstacle_avoider/obstacle_avoider"/>
        <dl_setting var="OA_MIN_DIVERGENCE" min="0.001" step="0.001" max="0.1" shortname="min_div" module="mav_course_exercise/obstacle_avoider/obstacle_avoider"/>
        <dl_setting var="OA_IMG_WIDTH"      min="100" step="8"   max="640"  shortname="img_width"  module="mav_course_exercise/obstacle_avoider/obstacle_avoider"/>
      </dl_settings>
    </dl_settings>
  </settings>
  <header>
    <file name="obstacle_avoider.h"/>
  </header>
  <init fun="obstacle_avoider_init()"/>
  <periodic fun="obstacle_avoider_run()" freq="20" start="obstacle_avoider_init()"/>
  <makefile target="ap|nps">
    <file name="obstacle_avoider.c"/>
    <flag name="CFLAGS" value="I$(PAPARAZZI_SRC)/sw/airborne"/>
  </makefile>
</module>